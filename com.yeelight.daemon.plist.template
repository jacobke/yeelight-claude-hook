<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yeelight.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/path/to/yeelight-daemon.py</string>
        <string>--ip</string>
        <string>YOUR_YEELIGHT_IP</string>
        <string>--instance</string>
        <string>0</string>
        <!--
            --shared N: 如果多台电脑共享同一台设备，每台 daemon 设 N=电脑总数，
            自动按 N 分摊命令配额（默认 N=1，即 60 命令/分钟）。
            例：2 台电脑共享 → --shared 2 → 每 daemon 30 命令/分钟。
        -->
        <string>--shared</string>
        <string>1</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/yeelight-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/yeelight-daemon.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>